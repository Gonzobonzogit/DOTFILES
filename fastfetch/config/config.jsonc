{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/gonzo/.local/share/fastfetch/imgs/unixChanFastech.png",
        "height": 28,
        "width": 36,
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "custom",
            "format": "  __ _  ___  _ __  _______"
        },
        {
            "type": "custom",
            "format": " / _` |/ _ \\| '_ \\|_  / _ \\"
        },
        {
            "type": "custom",
            "format": "| (_| | (_) | | | |/ / (_) |"
        },
        {
            "type": "custom",
            "format": " \\__, |\\___/|_| |_/___\\___/"
        },
        {
            "type": "custom",
            "format": " |___/"
        },
        {
            "type": "custom",
            "format": "| |._ _ |_ ._o _ |"
        },
        {
            "type": "custom",
            "format": "|_|| | ||_)| |(/_|"
        },
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│   user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ 󰇅  host    {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {icon}distro  {#keys} │",
            "type": "os",
            "format": "{pretty-name}"
        },
        {
            "key": "│   kernel {#keys}│",
            "type": "kernel",
            "format": "{release}"
        },
        {
            "key": "│ 󰇄  DE/WM  {#keys}│",
            "type": "wm",
            "format": "{pretty-name}"
        },
        {
            "key": "│   terminal{#keys}│",
            "type": "terminal",
            "format": "{pretty-name} {version}"
        },
        {
            "key": "│   shell  {#keys}│",
            "type": "shell",
            "format": "{pretty-name} {version}"
        },
        {
            "key": "│ 󰍛  cpu     {#keys}│",
            "type": "cpu",
            "format": "{name}",
            "showPeCoreCount": true
        },
        {
            "key": "│ 󰍛  gpu     {#keys}│",
            "type": "gpu",
            "format": "{name}"
        },
        {
            "key": "│ 󰉉  disk    {#keys}│",
            "type": "disk",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "key": "│   memory {#keys}│",
            "type": "memory",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "type": "media",
            "key": "│ ♪ music   {#keys}│",
            "format": "{?artist}{artist} - {?}{title}",
            "keyColor": "cyan"
        },
        {
            "key": "│  colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
